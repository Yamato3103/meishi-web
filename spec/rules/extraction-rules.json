{
  "version": "0.1.0",
  "description": "名刺フィールド抽出ルール。決定論的(regex+ラベル+辞書+レイアウト)。クラウドAI不使用。",
  "normalization": {
    "applyNFKC": true,
    "lowercaseEmail": true,
    "keepDigitsOnlyKeyForPhones": true
  },
  "fields": [
    {
      "key": "email",
      "cardinality": "list",
      "detectors": [
        {
          "kind": "regex",
          "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
          "normalize": "lowercase",
          "confidence": 0.96
        }
      ]
    },
    {
      "key": "url",
      "cardinality": "list",
      "detectors": [
        {
          "kind": "regex",
          "pattern": "https?://[A-Za-z0-9./?#@%&=_~+-]+",
          "confidence": 0.95
        },
        {
          "kind": "regex",
          "pattern": "www\\.[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
          "confidence": 0.8
        }
      ],
      "excludeIfMatchedBy": ["email"],
      "note": "emailにマッチした部分文字列は除外(ドメイン誤検出防止)。"
    },
    {
      "key": "postalCode",
      "cardinality": "single",
      "detectors": [
        {
          "kind": "regex",
          "pattern": "[〒™\\s]*([0-9]{3}-[0-9]{4})",
          "captureGroup": 1,
          "confidence": 0.9
        }
      ]
    },
    {
      "key": "mobile",
      "cardinality": "list",
      "detectors": [
        {
          "kind": "labeledValue",
          "labels": ["携帯", "Mobile", "Cell", "モバイル", "M"],
          "valuePattern": "0[789]0[-\\s]?[0-9]{4}[-\\s]?[0-9]{4}",
          "confidence": 0.9
        },
        {
          "kind": "regex",
          "pattern": "0[789]0-[0-9]{4}-[0-9]{4}",
          "confidence": 0.75,
          "note": "ラベル無しでも携帯番号パターンは携帯とみなす"
        }
      ]
    },
    {
      "key": "fax",
      "cardinality": "list",
      "detectors": [
        {
          "kind": "labeledValue",
          "labels": ["FAX", "Fax", "fax", "ファックス", "ファクス", "F"],
          "valuePattern": "0[0-9]{1,4}[-(\\s]?[0-9]{1,4}[-)\\s]?[0-9]{3,4}",
          "confidence": 0.9
        }
      ]
    },
    {
      "key": "phone",
      "cardinality": "list",
      "detectors": [
        {
          "kind": "labeledValue",
          "labels": ["TEL", "Tel", "tel", "電話", "℡", "代表", "T"],
          "valuePattern": "0[0-9]{1,4}[-(\\s]?[0-9]{1,4}[-)\\s]?[0-9]{3,4}",
          "confidence": 0.9
        },
        {
          "kind": "regex",
          "pattern": "0[0-9]{1,4}-[0-9]{1,4}-[0-9]{3,4}",
          "confidence": 0.6,
          "note": "ラベル無しの固定電話候補。FAX/携帯に採用済みの番号は除外。"
        }
      ],
      "excludeIfMatchedBy": ["fax", "mobile"]
    },
    {
      "key": "company",
      "cardinality": "single",
      "detectors": [
        {
          "kind": "dictionaryContains",
          "dictionary": "corporateSuffix",
          "confidence": 0.9
        },
        {
          "kind": "layoutTopCompany",
          "topRegionMaxY": 0.35,
          "confidence": 0.55,
          "note": "上部35%にあり、氏名でない大きめの行を会社候補に。"
        }
      ]
    },
    {
      "key": "department",
      "cardinality": "single",
      "detectors": [
        {
          "kind": "dictionaryContains",
          "dictionary": "departmentTokens",
          "confidence": 0.7,
          "excludeIfMatchedBy": ["company"]
        }
      ]
    },
    {
      "key": "title",
      "cardinality": "single",
      "detectors": [
        {
          "kind": "dictionaryContains",
          "dictionary": "titles",
          "confidence": 0.8
        }
      ]
    },
    {
      "key": "personName",
      "cardinality": "single",
      "detectors": [
        {
          "kind": "layoutLargestText",
          "excludeIfMatchedBy": ["company", "department", "title", "email", "url"],
          "confidence": 0.6,
          "note": "会社/部署/役職/連絡先でない行のうち、bbox.hが最大級を氏名に。"
        }
      ],
      "subfields": {
        "familyKana": {
          "detector": {
            "kind": "furiganaLine",
            "scriptOnly": ["hiragana", "katakana"],
            "relativeTo": "personName",
            "maxHeightRatio": 0.7,
            "confidence": 0.55
          },
          "note": "氏名候補の直上/直下の、かなのみ・小さい行の姓部分。無ければ空(手入力補完)。"
        },
        "givenKana": {
          "detector": {
            "kind": "furiganaLine",
            "scriptOnly": ["hiragana", "katakana"],
            "relativeTo": "personName",
            "maxHeightRatio": 0.7,
            "confidence": 0.55
          }
        }
      }
    },
    {
      "key": "address",
      "cardinality": "single",
      "detectors": [
        {
          "kind": "prefectureLine",
          "dictionary": "prefectures",
          "followPostalCode": true,
          "joinContinuationLines": true,
          "confidence": 0.75,
          "note": "都道府県を含む行、または〒直後の行から始め、建物名などの継続行を連結。"
        }
      ]
    },
    {
      "key": "sns",
      "cardinality": "list",
      "detectors": [
        {
          "kind": "regex",
          "pattern": "(https?://)?(www\\.)?(twitter|x|facebook|instagram|linkedin)\\.com/[A-Za-z0-9._/-]+",
          "confidence": 0.8
        }
      ]
    }
  ],
  "dictionaries": {
    "corporateSuffix": [
      "株式会社", "有限会社", "合同会社", "合資会社", "合名会社",
      "一般社団法人", "公益社団法人", "一般財団法人", "公益財団法人",
      "特定非営利活動法人", "医療法人", "学校法人", "宗教法人",
      "(株)", "(有)", "(株)", "(有)",
      "Inc.", "Inc", "Co., Ltd.", "Co.,Ltd.", "Corporation", "Corp.",
      "K.K.", "LLC", "LLP", "Ltd.", "Ltd", "GmbH", "Company"
    ],
    "titles": [
      "代表取締役社長", "代表取締役", "取締役会長", "取締役", "執行役員",
      "会長", "社長", "副社長", "専務", "常務", "監査役",
      "本部長", "部長", "次長", "課長", "係長", "主任", "主査", "リーダー",
      "マネージャー", "ディレクター", "プロデューサー", "エンジニア", "デザイナー",
      "代表", "共同代表", "CEO", "COO", "CTO", "CFO", "CMO", "President", "Director", "Manager", "Engineer"
    ],
    "departmentTokens": [
      "事業部", "本部", "統括部", "部", "課", "室", "係", "グループ", "チーム",
      "支店", "営業所", "支社", "センター", "研究所", "工場", "オフィス", "Division", "Department", "Group", "Team"
    ],
    "prefectures": [
      "北海道", "青森県", "岩手県", "宮城県", "秋田県", "山形県", "福島県",
      "茨城県", "栃木県", "群馬県", "埼玉県", "千葉県", "東京都", "神奈川県",
      "新潟県", "富山県", "石川県", "福井県", "山梨県", "長野県", "岐阜県",
      "静岡県", "愛知県", "三重県", "滋賀県", "京都府", "大阪府", "兵庫県",
      "奈良県", "和歌山県", "鳥取県", "島根県", "岡山県", "広島県", "山口県",
      "徳島県", "香川県", "愛媛県", "高知県", "福岡県", "佐賀県", "長崎県",
      "熊本県", "大分県", "宮崎県", "鹿児島県", "沖縄県"
    ]
  },
  "companyNormalizationForKey": {
    "stripSuffixes": [
      "株式会社", "有限会社", "合同会社", "合資会社", "合名会社",
      "(株)", "(有)", "(株)", "(有)",
      "Inc.", "Inc", "Co., Ltd.", "Co.,Ltd.", "Corporation", "Corp.",
      "K.K.", "LLC", "Ltd.", "Ltd"
    ],
    "applyNFKC": true,
    "trimWhitespace": true,
    "note": "重複検知(E6)の突合キー生成用。抽出結果の表示値は原文を維持する。"
  }
}
